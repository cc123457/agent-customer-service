# ===== 模型服务配置 =====
# 说明：复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除，请勿提交。

# 模型服务 API Key（OpenAI 兼容协议）
DASHSCOPE_API_KEY=sk-你的key

# API Base URL（OpenAI 兼容模式）
# 官方示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# 也可替换为你使用的任意兼容网关地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 认证配置 =====
# JWT 签名密钥（务必改成随机长字符串，可运行 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=你的随机密钥

# ===== 可观测性配置（Langfuse，可选）=====
# 到 https://cloud.langfuse.com 注册后，在项目设置里获取这两个 key
LANGFUSE_PUBLIC_KEY=pk-lf-你的public_key
LANGFUSE_SECRET_KEY=sk-lf-你的secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ===== MCP 服务配置 =====
# 天气 MCP 服务地址（独立进程，见 mcp_servers/weather_server.py，默认本地 8001）
WEATHER_MCP_URL=http://127.0.0.1:8001/mcp

# ===== Redis 配置（可选）=====
# 会话记忆 / 限流器优先用 Redis；不填或连不上会自动降级到内存实现
REDIS_URL=redis://127.0.0.1:6379/0
