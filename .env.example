# ===== 模型服务配置 =====
# 说明：复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除，请勿提交。

# 模型服务 API Key（OpenAI 兼容协议）
DASHSCOPE_API_KEY=sk-你的key

# API Base URL（OpenAI 兼容模式）
# 官方示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# 也可替换为你使用的任意兼容网关地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：覆盖config/rag.yml中的Embedding模型；不会自动混用/回退到别的模型。
# EMBEDDING_MODEL_NAME=text-embedding-v3

# ===== 认证配置 =====
# JWT 签名密钥（务必改成随机长字符串，可运行 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=你的随机密钥

# ===== 可观测性配置（Langfuse，可选）=====
# 到 https://cloud.langfuse.com 注册后，在项目设置里获取这两个 key
LANGFUSE_PUBLIC_KEY=pk-lf-你的public_key
LANGFUSE_SECRET_KEY=sk-lf-你的secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ===== MCP 服务配置 =====
# 天气 MCP 服务地址（独立进程，见 mcp_servers/weather_server.py，默认本地 8001）
WEATHER_MCP_URL=http://127.0.0.1:8001/mcp

# ===== Redis 配置（可选）=====
# 控制Redis：快速租约/限流/缓存键目录，使用noeviction，与缓存实例物理隔离。
REDIS_URL=redis://127.0.0.1:6379/0
# 事实缓存Redis：必须是另一实例；不配置则事实查询走SQL，不混用控制实例。
FACT_CACHE_REDIS_URL=redis://127.0.0.1:6380/0
# 开发起始预算，可按压测覆盖；maxmemory不是进程总内存上限。
CONTROL_REDIS_MAXMEMORY=128mb
FACT_CACHE_REDIS_MAXMEMORY=256mb
# Docker缓存映射到宿主机的端口（容器内始终6379）
FACT_CACHE_REDIS_PORT=6380
# 多进程部署应设1；控制Redis不可用时返回503，避免将本机兜底当作全局限流。
REDIS_CONTROL_REQUIRED=0

# 历史/长期记忆数据库：未配置时使用独立 data/memory.db，不迁移现有 data/agent.db。
# MySQL先创建专用数据库和账号；密码中的特殊字符需URL编码。
# 本机示例：mysql+pymysql://agent:URL_ENCODED_PASSWORD@127.0.0.1:3306/agent_memory?charset=utf8mb4
# Docker叠加docker-compose.mysql.yml时，主机名用memory-db，端口3306。
MEMORY_DATABASE_URL=
MEMORY_DB_PASSWORD=
MEMORY_DB_ROOT_PASSWORD=
